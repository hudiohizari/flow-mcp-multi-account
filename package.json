{
  "name": "flow-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that drives Google Flow in a dedicated Chrome profile",
  "main": "index.js",
  "scripts": {
    "test": "npm run build && node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 --test-coverage-include='dist/account-*.js' --test-coverage-include='dist/accounts.js' --test-coverage-include='dist/chrome-process.js' --test-coverage-include='dist/chrome.js' --test-coverage-include='dist/config.js' --test-coverage-include='dist/core-accounts.js' --test-coverage-include='dist/core-media.js' --test-coverage-include='dist/core.js' --test-coverage-include='dist/errors.js' --test-coverage-include='dist/flow-agent-plan.js' --test-coverage-include='dist/flow-credits.js' --test-coverage-include='dist/i18n.js' --test-coverage-include='dist/login-cli.js' --test-coverage-include='dist/mcp-*.js' --test-coverage-include='dist/media-schemas.js' --test-coverage-include='dist/platform.js' --test-coverage-include='dist/queue.js' --test-coverage-include='dist/remote.js' --test-coverage-include='dist/schemas.js' --test-coverage-include='dist/server.js' --test-coverage-include='dist/shared/*.js' --test-coverage-include='dist/studio/*.js' tests/*.test.ts",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "node dist/login.js",
    "studio": "node dist/studio.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bin": {
    "flow-mcp": "dist/index.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "kokoro-js": "^1.2.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
